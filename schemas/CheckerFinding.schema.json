{
  "$defs": {
    "CheckerName": {
      "enum": [
        "lean_integrity",
        "source_fidelity",
        "library_context",
        "semantic_sanity"
      ],
      "title": "CheckerName",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A pointer a reader can chase. Findings without evidence are not actionable.",
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "kind": {
          "description": "file_line | lean_dependency_path | axioms | source_quote | lean_quote",
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingCategory": {
      "description": "Finding vocabulary, grouped by the checker that emits it.\n\nSeeded from the 37 categorised issues in `files/evidence/issues.jsonl` so that the\nhistorical findings can be replayed against the new schema without translation.",
      "enum": [
        "COMPILE_FAILURE",
        "PARSE_ERROR",
        "UNKNOWN_IDENTIFIER",
        "IMPORT_FAILURE",
        "TYPECLASS_FAILURE",
        "DIRECT_SORRY",
        "TRANSITIVE_SORRY",
        "UNFINISHED_CONSTRUCTION",
        "VACUOUS_DEPENDENCY",
        "AXIOM_TRUST",
        "LINT",
        "RENAMING",
        "NOTATION_MAPPING",
        "REPRESENTATION_CHANGE",
        "SPECIALIZATION",
        "GENERALIZATION",
        "SEMANTIC_DEVIATION",
        "MISSING_ASSUMPTION",
        "OVERSTRONG_ASSUMPTION",
        "OVERWEAK_CONCLUSION",
        "DUPLICATE_DECLARATION",
        "MATHLIB_DUPLICATION",
        "STRONGER_RESULT_EXISTS",
        "NAMING_CONFLICT",
        "ABSTRACTION_LEVEL",
        "DEPENDENCY_MISMATCH",
        "UNNECESSARY_REINVENTION",
        "EMPTY_TYPE",
        "SINGLETON_CASE",
        "TRIVIAL_CASE",
        "ZERO_PARAMETER",
        "VACUOUS_QUANTIFICATION",
        "MISSING_NONEMPTY",
        "MISSING_CARDINALITY",
        "BOUNDARY_CONDITION",
        "SUSPICIOUS_ASSUMPTION",
        "SUSPICIOUS_CONCLUSION",
        "SOURCE_PROVENANCE",
        "IDENTITY_MISMATCH",
        "UNCERTAIN"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "unknown"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where an artifact came from and what it was produced against.\n\nReport 01 \u00a7B4 is the reason this exists and is required on every agent-produced\nartifact: the summer's annotations asserted repository facts with no record of the\nrepository state they were written against, and those assertions went silently false.",
      "properties": {
        "context_package_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ContextPackage this artifact was generated from.",
          "title": "Context Package Id"
        },
        "corpus_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Corpus registry version this was generated against.",
          "title": "Corpus Version"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fingerprint of the exact input content (staleness check).",
          "title": "Input Fingerprint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model id, or None if deterministic.",
          "title": "Model"
        },
        "producer": {
          "description": "Component that produced the artifact, e.g. 'annotator'.",
          "title": "Producer",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version-controlled prompt identifier, e.g. 'annotate/v1'.",
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM provider, or None for deterministic producers.",
          "title": "Provider"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocks_progression": {
      "default": false,
      "title": "Blocks Progression",
      "type": "boolean"
    },
    "category": {
      "$ref": "#/$defs/FindingCategory"
    },
    "checker": {
      "$ref": "#/$defs/CheckerName"
    },
    "checker_version": {
      "title": "Checker Version",
      "type": "string"
    },
    "confidence": {
      "description": "Deterministic checkers must report 1.0; see the validator below.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "declaration_id": {
      "title": "Declaration Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "description": "'f-' plus a deterministic digest of the finding's identity.",
      "title": "Id",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "producer_declared": {
      "default": false,
      "description": "True when the producing stage already flagged this itself. Report 03 \u00a70.3: the summer's Lean carries 508 self-reported hazard markers, several with the repair written out. Such findings are cheaper to confirm and should be visibly distinguished from ones a checker inferred.",
      "title": "Producer Declared",
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "requires_human": {
      "default": false,
      "title": "Requires Human",
      "type": "boolean"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus"
    },
    "suggested_repair": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Repair"
    }
  },
  "required": [
    "id",
    "declaration_id",
    "checker",
    "checker_version",
    "status",
    "category",
    "severity",
    "confidence",
    "message",
    "provenance"
  ],
  "title": "CheckerFinding",
  "type": "object"
}
