{
  "$defs": {
    "EdgeProvenance": {
      "additionalProperties": false,
      "description": "Why the pipeline believes an edge exists.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Persisted artifact the assertion came from, e.g. an annotation id.",
          "title": "Artifact Id"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it was read from: file:line, or the raw citation.",
          "title": "Evidence"
        },
        "kind": {
          "$ref": "#/$defs/EdgeProvenanceKind"
        },
        "producer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Component that asserted the edge, e.g. 'annotator'.",
          "title": "Producer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EdgeProvenance",
      "type": "object"
    },
    "EdgeProvenanceKind": {
      "enum": [
        "source_extracted",
        "lean_extracted",
        "agent_inferred",
        "human_confirmed"
      ],
      "title": "EdgeProvenanceKind",
      "type": "string"
    },
    "EdgeType": {
      "description": "Corpus-graph edge types.\n\n``provenance`` on each edge (see :class:`pipeline.artifacts.models.graph.DependencyEdge`) decides\nwhether it may gate progression: report 06 \u00a7E.2 -- only source-extracted and\nLean-extracted edges are exact enough to block automatically.",
      "enum": [
        "informal_dependency",
        "source_cross_reference",
        "lean_local_dependency",
        "mathlib_dependency",
        "helper_dependency",
        "formalizes",
        "example_of",
        "supersedes"
      ],
      "title": "EdgeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "edge_type": {
      "$ref": "#/$defs/EdgeType"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated: prefer provenance.evidence. Kept readable.",
      "title": "Evidence"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "provenance": {
      "$ref": "#/$defs/EdgeProvenance"
    },
    "source_id": {
      "description": "Declaration id, or 'library:<Name>' for library nodes.",
      "title": "Source Id",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "target_id",
    "edge_type",
    "provenance"
  ],
  "title": "DependencyEdge",
  "type": "object"
}
