{
  "$defs": {
    "DeclarationStage": {
      "description": "How far one declaration has travelled. Derived from artifacts, never asserted.",
      "enum": [
        "INGESTED",
        "ANNOTATED",
        "FORMALIZED",
        "CHECKED",
        "APPROVED",
        "PROVED"
      ],
      "title": "DeclarationStage",
      "type": "string"
    },
    "DeclarationState": {
      "additionalProperties": false,
      "description": "Per-declaration bookkeeping for one run.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocked Reason"
        },
        "declaration_id": {
          "title": "Declaration Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Kind"
        },
        "last_context_package_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Context Package Id"
        },
        "last_stage_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Stage Run Id"
        },
        "stage": {
          "$ref": "#/$defs/DeclarationStage",
          "default": "INGESTED"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "ok"
        }
      },
      "required": [
        "declaration_id"
      ],
      "title": "DeclarationState",
      "type": "object"
    },
    "RunEvent": {
      "additionalProperties": false,
      "description": "One thing that happened, in order. The run timeline's backing data.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "declaration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declaration Id"
        },
        "kind": {
          "description": "stage_ok | stage_failed | gate | status | note",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "StageRun id, when one was recorded.",
          "title": "Run Id"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RunEvent",
      "type": "object"
    },
    "RunStatus": {
      "description": "Lifecycle of one pipeline run.",
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_FOR_HUMAN_REVIEW",
        "PROVING",
        "VERIFIED",
        "FAILED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StepStatus": {
      "enum": [
        "ok",
        "failed",
        "skipped",
        "blocked"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One invocation of the pipeline over a set of declarations.",
  "properties": {
    "corpus": {
      "title": "Corpus",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declarations": {
      "additionalProperties": {
        "$ref": "#/$defs/DeclarationState"
      },
      "title": "Declarations",
      "type": "object"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RunEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "QUEUED"
    },
    "stop_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeclarationStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Gate: the run halts rather than advancing past this stage."
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "corpus"
  ],
  "title": "PipelineRun",
  "type": "object"
}
